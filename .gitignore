venv
```gitignore
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Test and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.pyright/
.ruff_cache/

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment files
.env
.env.*
!.env.example

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Qt / PySide generated files
*.pyc

# Local configuration
config.local.*
settings.local.*

# Build artifacts
*.spec
```