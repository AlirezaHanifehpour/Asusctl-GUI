QMainWindow {
    background-color: #101820;
}

QLabel {
    color: white;
    font-size: 20px;
}

QPushButton {
    background-color: #006eff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 20px;
}

QPushButton:hover {
    background-color: #005dcc;
}

QComboBox {
    background-color: #1b2633;
    color: white;
    border: 1px solid #34495e;
    border-radius: 5px;
    padding: 6px;
    font-size: 20px;
}